{
  "name": "steamclip-decky",
  "version": "1.4.0",
  "type": "module",
  "description": "Decky-Plugin: Steam-Clips als MP4 an ein Tailscale-Gerät senden (Dateiauswahl, Zielgerät-Auswahl mit Online-Status, Fortschritt).",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --format=esm --platform=browser --target=es2020 --jsx=automatic --alias:@decky/ui=./shims/ui.js --alias:@decky/manifest=./shims/manifest.json --alias:react=./shims/react.js --alias:react/jsx-runtime=./shims/jsx.js --outfile=dist/index.js --minify",
    "smoke": "node test-import.mjs"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0"
  },
  "devDependencies": {
    "@decky/ui": "^4.11.0",
    "esbuild": "^0.28.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
